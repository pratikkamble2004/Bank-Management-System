# ========================================================
# Apex Bank Management System - Environment Template
# Copy this file to .env and replace placeholders with your actual secrets.
# ========================================================

# Database Connection Settings
DB_HOST=localhost
DB_PORT=3306
DB_NAME=bank_management
DB_URL=jdbc:mysql://localhost:3306/bank_management?useSSL=false&serverTimezone=UTC&allowPublicKeyRetrieval=true
DB_USERNAME=your_mysql_username
DB_PASSWORD=your_mysql_password

# Server Ports
BACKEND_PORT=8080
FRONTEND_PORT=4200

# ========================================================
# Test / Demo Credentials Template
# ========================================================

# Admin / Bank Employee Portal
ADMIN_USERNAME=admin
ADMIN_PASSWORD=your_admin_password
ADMIN_ROLE=ADMIN

# Primary Customer Account
CUSTOMER_USERNAME=pratik
CUSTOMER_PASSWORD=your_customer_password
CUSTOMER_ACCOUNT_NUMBER=1000000001
CUSTOMER_ROLE=CUSTOMER

# Secondary Customer Account
DEMO_USERNAME=demo
DEMO_PASSWORD=your_demo_password
DEMO_ACCOUNT_NUMBER=1000000002
DEMO_ROLE=CUSTOMER
